{
  "name": "rpe-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Suivi de la charge d'entrainement (RPE) pour joueurs et coachs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:palette": "node scripts/validate_palette.js",
    "check:schema": "node scripts/check-schema-types.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:query": "node --env-file=.env.local scripts/db-query.mjs",
    "db:verify": "node --env-file=.env.local scripts/smoke-rls.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
